ger#how-it-works","content":"How it works"},"1982":{"id":"/docs/interface/keylogger-4","page_id":"/docs/interface/keylogger","type":"heading","url":"/docs/interface/keylogger#windows","content":"Windows"},"1983":{"id":"/docs/interface/keylogger-5","page_id":"/docs/interface/keylogger","type":"heading","url":"/docs/interface/keylogger#linux","content":"Linux"},"1984":{"id":"/docs/interface/keylogger-6","page_id":"/docs/interface/keylogger","type":"heading","url":"/docs/interface/keylogger#macos","content":"MacOS"},"1985":{"id":"/docs/interface/keylogger-7","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger","content":"The keylogger tab, like the screenshot tab, is a passive feature. It only reads and edits keys already captured from a host."},"1986":{"id":"/docs/interface/keylogger-8","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger","content":"You can open the Keylogger tab from the  icon in the top bar, or from Tabs > Keylogger."},"1987":{"id":"/docs/interface/keylogger-9","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#how-to-use","content":"To use the keylogger tab, follow these steps:"},"1988":{"id":"/docs/interface/keylogger-10","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#start-the-keylogger","content":"In the terminal, run keylogger start to start the keylogger. On Windows, use the --method [keystate|boardstate] flag to change the capture method."},"1989":{"id":"/docs/interface/keylogger-11","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#refresh-the-keylogger-tab","content":"The keylogger tab does not update automatically, so refresh it manually by clicking ."},"1990":{"id":"/docs/interface/keylogger-12","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#refresh-the-keylogger-tab","content":"The keylogger tab does not require selecting a host or server. A request is already sent to all configured team servers."},"1991":{"id":"/docs/interface/keylogger-13","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#how-it-works","content":"The keylogger runs in a separate background thread and sends captured keys to the server in batches."},"1992":{"id":"/docs/interface/keylogger-14","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#windows","content":"As noted above, the Windows keylogger supports two capture methods: one prioritizes OPSEC and the other prioritizes capture accuracy."},"1993":{"id":"/docs/interface/keylogger-15","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#windows","content":"keystate uses a low level keyboard hook through SetWindowsHookEx. More visible to hook monitoring, but avoids broad polling."},"1994":{"id":"/docs/interface/keylogger-16","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#windows","content":"boardstate is the default when you omit --method. It uses GetAsyncKeyState from user32.dll and polls key state in a loop. No hook is installed, but repeated polling can stand out."},"1995":{"id":"/docs/interface/keylogger-17","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#windows","content":"The core logic is in implants/windows/stageless/capabilities/keylogger.nim."},"1996":{"id":"/docs/interface/keylogger-18","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#linux","content":"Uses X11 (libX11.so) with XOpenDisplay and XQueryKeymap. Requires DISPLAY. The core logic is in implants/linux/stageless/capabilities/keylogger.nim."},"1997":{"id":"/docs/interface/keylogger-19","page_id":"/docs/interface/keylogger","type":"text","url":"/docs/interface/keylogger#macos","content":"This feature is not supported on MacOS."},"1998":{"id":"/docs/interface/processes","page_id":"/docs/interface