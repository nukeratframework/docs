rShell. Supports local and remote execution via WS Management with built in CLM, AMSI, and WLDP bypasses, module import, encrypted payloads, and reflective PE injection. If executed without a target, runs locally. Must run as a privileged user when using PowerShell Remoting."},"1425":{"id":"/docs/armory-1390","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"net-cheese-rdp"},"1426":{"id":"/docs/armory-1391","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"dotnet"},"1427":{"id":"/docs/armory-1392","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"RDP credential stealer via reflective DLL injection into mstsc.exe. Must run in the context of a privileged user or a user with SeImpersonatePrivilege. Built on RdpThief and wrapped for .NET reflection loading."},"1428":{"id":"/docs/armory-1393","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"net-cheese-sql"},"1429":{"id":"/docs/armory-1394","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"dotnet"},"1430":{"id":"/docs/armory-1395","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"MSSQL trust abuse tool for command execution and lateral movement. Supports domain SPN discovery, linked server enumeration, impersonation, xp_cmdshell, OLE automation, CLR assembly abuse, and OPENQUERY execution. Type net-cheese-sql &lt;command&gt; /help for per command argument details."},"1431":{"id":"/docs/armory-1396","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"net-cimplant"},"1432":{"id":"/docs/armory-1397","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"dotnet"},"1433":{"id":"/docs/armory-1398","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"Supports file operations, registry, services, process management, lateral movement facilitation, and system enumeration. Requires local administrator permissions on the target system."},"1434":{"id":"/docs/armory-1399","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"net-com-hunter"},"1435":{"id":"/docs/armory-1400","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"dotnet"},"1436":{"id":"/docs/armory-1401","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"Enumerates COM servers registered in LocalServer32 and InProcServer32 keys using WMI."},"1437":{"id":"/docs/armory-1402","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"net-cred-phisher"},"1438":{"id":"/docs/armory-1403","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"dotnet"},"1439":{"id":"/docs/armory-1404","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"Prompts the current user for credentials using CredUIPromptForWindowsCredentials."},"1440":{"id":"/docs/armory-1405","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"net-crop"},"1441":{"id":"/docs/armory-1406","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"dotnet"},"1442":{"id":"/docs/armory-1407","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"Creates LNK, URL, library-ms, or searchConnector-ms files that point to a WebDAV server. When a user browses a folder containing the file, Explorer may authenticate to the WebDAV server and leak NetNTLM hashes to Farmer."},"1443":{"id":"/docs/armory-1408","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"net-driver-query"},"1444":{"id":"/docs/armory-1409","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"dotnet"},"1445":{"id":"/docs/armory-1410","page_id":"/docs/armory","type":"text","url":"/docs/armory#catalog","content":"Collects details about loaded drivers and optionally filters to non-Microsoft signed drivers."},"1446":{"i