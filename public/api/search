ent":"Explanation\nReturns all active listeners on the team server."},"2701":{"id":"/docs/rest-api/team-server-26","page_id":"/docs/rest-api/team-server","type":"text","url":"/docs/rest-api/team-server#listeners","content":"Explanation\nCreates or restarts a channel or file server listener."},"2702":{"id":"/docs/rest-api/team-server-27","page_id":"/docs/rest-api/team-server","type":"text","url":"/docs/rest-api/team-server#listeners","content":"Explanation\nPermanently removes a listener."},"2703":{"id":"/docs/rest-api/team-server-28","page_id":"/docs/rest-api/team-server","type":"text","url":"/docs/rest-api/team-server#implant-creation","content":"Builds stageless or loader implants."},"2704":{"id":"/docs/rest-api/team-server-29","page_id":"/docs/rest-api/team-server","type":"text","url":"/docs/rest-api/team-server#implant-creation","content":"Explanation\nBuilds an implant as stageless or loader."},"2705":{"id":"/docs/rest-api/team-server-30","page_id":"/docs/rest-api/team-server","type":"text","url":"/docs/rest-api/team-server#sessions","content":"Manage implant sessions on the team server."},"2706":{"id":"/docs/rest-api/team-server-31","page_id":"/docs/rest-api/team-server","type":"text","url":"/docs/rest-api/team-server#sessions","content":"Explanation\nReturns all sessions on the team server. Use mode=graphs for attack-graph data. Use mode=sessions_lp to long-poll until host privilege, relay, or listener state changes, then return the same sessions array as mode=default."},"2707":{"id":"/docs/rest-api/team-server-32","page_id":"/docs/rest-api/team-server","type":"text","url":"/docs/rest-api/team-server#sessions","content":"Explanation\nUpdates operator notes for an existing session. Returns failure when the tag is missing or not found."},"2708":{"id":"/docs/rest-api/team-server-33","page_id":"/docs/rest-api/team-server","type":"text","url":"/docs/rest-api/team-server#sessions","content":"Explanation\nRemoves the host from the team server (this does not stop the